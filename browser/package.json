{
  "name": "oimlsmart-identity-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"astro dev\" \"tsx watch server/serve.ts\"",
    "dev:astro": "concurrently -k \"astro dev\" \"tsx watch server/serve.ts\"",
    "dev:server": "tsx watch server/serve.ts",
    "build": "astro build",
    "build:cloudflare": "ADAPTER=cloudflare astro build",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev --config dist/server/wrangler.json",
    "build:check": "npm run build && astro check && vue-tsc --noEmit",
    "check:astro": "astro check",
    "preview": "astro preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "tsx scripts/e2e-run.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@oimlsmart/platform-server": "^0.1.7",
    "@oimlsmart/site-shell": "^0.1.0",
    "dotenv": "^17.4.2",
    "hono": "^4.12.23",
    "js-yaml": "^4.1.1",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/node": "^11.0.2",
    "@astrojs/vue": "^7.0.1",
    "@cloudflare/workers-types": "^5.20260813.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "astro": "^7.2.1",
    "better-sqlite3": "^12.10.0",
    "concurrently": "^10.0.3",
    "puppeteer": "^25.1.0",
    "smol-toml": "^1.8.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7",
    "wrangler": "^4.122.0"
  }
}
