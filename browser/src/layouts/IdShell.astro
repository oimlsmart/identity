---
// ═══════════════════════════════════════════════════════════════════
// IdShell — the identity service's own minimal shell (the wave-02a
// identity-native frontend). NO platform chrome on this host: no
// federation nav, no platform consoles, no app PWA manifest. The house
// design tokens + blueprint arrive through ../styles/app.css (the
// @oimlsmart/site-shell CSS contract); the chrome is the identity
// brand's slim header bar (the account context on the right when a
// session exists), the page island, and the one-line footer with the
// status link.
//
// bare: the sign-in page (/) — no header (the page centers the brand
// block itself), the footer stays.
//
// DARK MODE follows the house shell's class pattern (the package's
// tokens.css @custom-variant + the oiml-theme localStorage key the
// inline script below reads before first paint): the toggle is the
// package's own ThemeToggle — the header's right end, or the footer's
// on the bare page (the sign-in page has no header to carry it).
// ═══════════════════════════════════════════════════════════════════
import IdPage from '../astro/IdPage.vue'
import AccountChip from '../components/AccountChip.vue'
import ThemeToggle from '@oimlsmart/site-shell/components/ThemeToggle.vue'
import '../styles/app.css'

interface Props {
  title?: string
  /** Key under src/vue-pages (no extension), e.g. "public/op-consent". */
  page: string
  /** The sign-in page's chromeless posture. */
  bare?: boolean
}
const { title = 'OIML SMART Identity', page, bare = false } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#004996" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="The OIML SMART identity service: the single sign-on service for the oimlsmart.org estate." />
    <title>{title} | OIML SMART Identity</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-cream dark:bg-slate-900 text-slate-900 dark:text-slate-100 antialiased min-h-screen flex flex-col">
    {!bare && (
      <header class="border-b border-slate-200 dark:border-slate-700">
        <div class="max-w-5xl mx-auto px-6 h-12 flex items-center justify-between">
          <a href="/" class="flex items-center gap-2 no-underline text-inherit" data-testid="shell-brand">
            <img src="/oiml-logo-light.svg" alt="The OIML SMART logo" class="h-6 w-auto dark:hidden" />
            <img src="/oiml-logo-dark.svg" alt="" class="h-6 w-auto hidden dark:block" aria-hidden="true" />
            <span class="font-serif text-sm font-semibold tracking-tight">OIML SMART Identity</span>
          </a>
          <div class="flex items-center gap-3">
            <ThemeToggle client:load />
            <AccountChip client:only="vue" />
          </div>
        </div>
      </header>
    )}
    <main class="flex-1 flex flex-col">
      {/* The single shell kind IS the app shell here — the data-layout
          landmark the moved legs' settle waits read (the monorepo's App
          layout's contract), wrapping the page island. */}
      <div data-layout="app">
        <IdPage page={page} client:only="vue" />
      </div>
    </main>
    <footer class="border-t border-slate-200 dark:border-slate-700 mt-8">
      <div class="max-w-5xl mx-auto px-6 py-5 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500 dark:text-slate-400">
        <span>OIML SMART Identity: the single sign-on service for the oimlsmart.org estate</span>
        <span class="flex items-center gap-3">
          <a href="/api/health" class="hover:underline" data-testid="shell-status">Service status</a>
          {/* The bare posture (the sign-in page) has no header: the
              theme toggle rides the footer there. */}
          {bare && <ThemeToggle client:load />}
        </span>
      </div>
    </footer>
    <script is:inline>
      var stored = localStorage.getItem('oiml-theme')
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
      if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark')
      }
    </script>
  </body>
</html>
