---
// ═══════════════════════════════════════════════════════════════════
// IdShell — the identity service's own minimal shell (the wave-02a
// identity-native frontend; the console chrome reimplemented in
// TODO.identity-features/07). NO platform chrome on this host: no
// federation nav, no platform consoles, no app PWA manifest. The house
// design tokens + blueprint arrive through ../styles/app.css (the
// @oimlsmart/site-shell CSS contract); the chrome is ONE integrated
// header bar (the brand, the current-section label + the nav
// disclosure toggle at phone widths, the theme toggle, the account
// chip), the console's section navigation as a LEFT RAIL at desktop
// widths / a disclosure sheet at phone widths (components/
// ConsoleChrome.vue — never a second bar stacked under the header),
// the page island, and the one-line footer with the status link.
//
// bare: the sign-in page (/) — no header (the page centers the brand
// block itself), the footer stays.
//
// The console areas (the home launcher, the account console, the admin
// console) mount the ConsoleChrome island; the flow pages (join, setup,
// consent, email-change) stay centered single-column surfaces with the
// header but no rail.
//
// DARK MODE follows the house shell's class pattern (the package's
// tokens.css @custom-variant + the oiml-theme localStorage key the
// inline script below reads before first paint): the toggle is the
// package's own ThemeToggle — the header's right end, or the footer's
// on the bare page (the sign-in page has no header to carry it).
// ═══════════════════════════════════════════════════════════════════
import IdPage from '../astro/IdPage.vue'
import AccountChip from '../components/AccountChip.vue'
import ConsoleChrome from '../components/ConsoleChrome.vue'
import EnvironmentRibbon from '../components/EnvironmentRibbon.vue'
import ShellFooter from '../components/ShellFooter.vue'
import ThemeToggle from '@oimlsmart/site-shell/components/ThemeToggle.vue'
import '../styles/app.css'

interface Props {
  title?: string
  /** Key under src/vue-pages (no extension), e.g. "public/op-consent". */
  page: string
  /** The sign-in page's chromeless posture. */
  bare?: boolean
}
const { title = 'OIML SMART Identity', page, bare = false } = Astro.props

// The page key decides the console chrome: the area (home / account /
// admin — the flow pages get none) and the admin rail's current entry
// (the registry detail pages highlight their parent surface, the same
// mapping the pre-07 per-page OpAdminNav carried).
type ConsoleArea = 'home' | 'account' | 'admin'
const ADMIN_CURRENT: Record<string, string> = {
  'public/op-admin-overview': 'overview',
  'public/op-admin-registry': 'registry',
  'public/op-admin-registry-user': 'registry',
  'public/op-admin-registry-org': 'organizations',
  'public/op-admin-organizations': 'organizations',
  'public/op-admin-sessions': 'sessions',
  'public/op-admin-clients': 'clients',
  'public/op-admin-activity': 'activity',
  'public/op-admin-providers': 'providers',
  'public/op-admin-security': 'security',
  'public/op-admin-users': 'users',
}
const consoleArea: ConsoleArea | null =
  page === 'home' ? 'home'
  : page === 'account' ? 'account'
  : page in ADMIN_CURRENT ? 'admin'
  : null
const adminCurrent = ADMIN_CURRENT[page]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#004996" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="The OIML SMART identity service: the single sign-on service for the oimlsmart.org estate." />
    <title>{title} | OIML SMART Identity</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-cream dark:bg-slate-900 text-slate-900 dark:text-slate-100 antialiased min-h-screen flex flex-col">
    {/* The environment ribbon (the ISO-benchmark quick win, item 5): a
        thin strip on a non-production posture (the deployment declares
        ENVIRONMENT_LABEL); production shows nothing. */}
    <EnvironmentRibbon client:load />
    {!bare && (
      <header class="border-b border-slate-200 dark:border-slate-700">
        {/* ONE integrated header: the brand (the wordmark yields to the
            mark alone at phone widths — the wrapped two-line brand was
            the 07 audit's phone-header defect), the ConsoleChrome's
            teleported slot (the disclosure toggle + the current-section
            label on the console pages), the theme toggle, the account
            chip. Never a second bar under it. */}
        <div class="max-w-6xl mx-auto px-4 sm:px-6 h-12 flex items-center gap-3">
          <a href="/" class="flex items-center gap-2 no-underline text-inherit shrink-0 min-w-0" data-testid="shell-brand">
            <img src="/oiml-logo-light.svg" alt="The OIML SMART logo" class="h-6 w-auto dark:hidden" />
            <img src="/oiml-logo-dark.svg" alt="" class="h-6 w-auto hidden dark:block" aria-hidden="true" />
            <span class="hidden sm:inline font-serif text-sm font-semibold tracking-tight whitespace-nowrap">OIML SMART Identity</span>
          </a>
          <span id="shell-chrome-slot" class="flex items-center gap-2 min-w-0 flex-1"></span>
          <div class="flex items-center gap-3 min-w-0 shrink-0">
            <ThemeToggle client:load />
            <AccountChip client:only="vue" />
          </div>
        </div>
      </header>
    )}
    <main class="flex-1 flex flex-col">
      {/* The single shell kind IS the app shell here — the data-layout
          landmark the moved legs' settle waits read (the monorepo's App
          layout's contract), wrapping the page island. The console
          areas get the rail + the content column (min-w-0 so a wide
          page child can never push the page sideways); the flow pages
          keep their centered single column. */}
      {consoleArea ? (
        <div class="max-w-6xl mx-auto w-full flex-1 flex items-start lg:gap-8 lg:px-6">
          <ConsoleChrome area={consoleArea} current={adminCurrent} client:only="vue" />
          <div data-layout="app" class="flex-1 min-w-0">
            <IdPage page={page} client:only="vue" />
          </div>
        </div>
      ) : (
        <div data-layout="app" class="flex-1 flex flex-col">
          <IdPage page={page} client:only="vue" />
        </div>
      )}
    </main>
    <footer class="border-t border-slate-200 dark:border-slate-700 mt-8">
      {/* The footer is an island: it follows the locale (the item-3
          switcher lives there) — the bare posture's theme toggle rides
          inside it. */}
      <ShellFooter bare={bare} client:load />
    </footer>
    <script is:inline>
      var stored = localStorage.getItem('oiml-theme')
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
      if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark')
      }
      // The anonymous locale choice, applied pre-paint (the signed-in
      // scope resolves on hydration — i18n/index.ts's setLocaleUser):
      // <html lang> must never lag the switch.
      var storedLocale = localStorage.getItem('oiml-smart-locale')
      if (storedLocale === 'en' || storedLocale === 'fr') {
        document.documentElement.lang = storedLocale
      }
    </script>
  </body>
</html>
