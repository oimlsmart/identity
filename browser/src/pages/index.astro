---
// The identity service's landing page: a plain status page naming the
// service and pointing at the docs. The product surface is the OP
// pages (/app/login, /op/consent, the account console); this page only
// orients a human who arrives at the root.
import { Base } from '@oimlsmart/site-shell'
import '../styles/app.css'
---

<Base title="OIML SMART Identity" description="The OIML SMART identity service: the OpenID Connect Provider at id.oimlsmart.org." brandName="OIML SMART Identity">
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-3xl font-bold mb-4">OIML SMART Identity</h1>
    <p class="mb-4">
      The identity service of the OIML SMART program: the OpenID Connect
      Provider (OP) every OIML SMART instance signs in through. Relying
      parties discover this service at
      <a class="underline" href="/.well-known/openid-configuration"><code>/.well-known/openid-configuration</code></a>
      and validate keys at <a class="underline" href="/jwks.json"><code>/jwks.json</code></a>.
    </p>
    <ul class="list-disc pl-6 space-y-2 mb-8">
      <li><a class="underline" href="/app/login">Sign in</a> to your account.</li>
      <li><a class="underline" href="/op/join">Request an account</a> for a registered participant organization.</li>
    </ul>
    <p class="text-sm">
      The integration guide for relying parties and the operations
      runbooks live in this repository under <code>docs/</code>:
      <code>docs/integration/identity-service.md</code>,
      <code>docs/deployment/identity-operations.md</code>.
    </p>
  </section>
</Base>
