# (The x/ sibling-checkout doctrine retired with TODO.repos/01: the
# platform-server kernel resolves from npm. Nothing to ignore.)

# OS files
.DS_Store
Thumbs.db

# node
node_modules/
dist/

# Local env files (never committed; .env.example templates excepted)
*.local
.env
.env.*
!.env.example

# Wrangler / the Cloudflare local posture: .dev.vars holds local-only
# vars, .wrangler the local D1 state. wrangler.self-host.toml is the
# self-host deploy overlay (TODO.self-host/02, scripts/deploy-instance.ts
# --overlay): the operator's own worker name / D1 ids / vars — never
# committed.
.dev.vars
.wrangler/
browser/wrangler.self-host.toml

# The e2e legs' per-stack SQLite files + vite caches
browser/.cache/

# Astro generated types
.astro/

# The local blob store (the avatar uploads in dev): uploaded bytes are
# seed-reproducible scratch, never committed.
browser/data/blobs/

# The node dev stack's local SQLite (the kernel's default path:
# <cwd>/../data/oiml-smart.db — scratch, gitignored by name).
/data/oiml-smart.db*
